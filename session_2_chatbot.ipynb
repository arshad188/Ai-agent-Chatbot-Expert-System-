# %% [markdown]
# ## 2.1 Rule-Based Chatbot (ELIZA-style)

# %%
import random

class SimpleChatbot:
    def __init__(self):
        self.responses = {
            "hi|hello|hey": ["Hello!", "Hi there!", "Hey! How can I help?"],
            "how are you": ["I'm doing great, thanks!", "All good here!", "Ready to chat!"],
            "name": ["I'm ChatBot 3000!", "Call me Botty.", "I don't have a name, but I'm here!"],
            "weather": ["I don't have access to weather data.", "Check your local forecast!"],
            "bye|exit|quit": ["Goodbye!", "See you later!", "Take care!"],
        }
    
    def respond(self, user_input):
        user_input = user_input.lower()
        for pattern, replies in self.responses.items():
            if any(word in user_input for word in pattern.split("|")):
                return random.choice(replies)
        return "I'm not sure how to respond to that. Can you rephrase?"

# %%
# Test it
bot = SimpleChatbot()
print("🤖 Chatbot: Type 'bye' to exit")
while True:
    user = input("You: ")
    if user.lower() in ["bye", "exit", "quit"]:
        print("Bot: Goodbye!")
        break
    print("Bot:", bot.respond(user))

# %% [markdown]
# ## 2.2 Generative Chatbot (using Transformers)
# *Note: This cell requires `transformers` library installed*

# %%
# !pip install transformers torch

# %%
from transformers import pipeline

# Load a small conversational model
generator = pipeline("text-generation", model="microsoft/DialoGPT-small")

def chat_with_gpt(prompt):
    response = generator(prompt, max_length=100, num_return_sequences=1)
    return response[0]['generated_text']

# %%
print("🧠 Generative Chatbot (DialoGPT)")
print("Type 'quit' to exit")
while True:
    user = input("You: ")
    if user.lower() == 'quit':
        break
    print("Bot:", chat_with_gpt(user))

