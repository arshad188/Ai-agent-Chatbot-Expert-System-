# # 🏥 Session 1: Expert Systems - Medical Triage
# **Learning Objectives**: Understand rule-based reasoning, forward chaining, and limitations

# %% [markdown]
# ## 1.1 Simple Rule Engine
# Let's build a diagnostic system using if-else rules

# %%
# Define our knowledge base
symptom_rules = {
    ("fever", "rash"): "Possible measles – consult a doctor immediately!",
    ("fever", "cough"): "Possible flu – rest, hydrate, and monitor temperature.",
    ("headache", "nausea"): "Possible migraine – rest in a dark, quiet room.",
    ("sore_throat", "fever"): "Possible strep throat – see a doctor for antibiotics.",
    ("fatigue", "weight_loss"): "Possible thyroid issue – get blood work done.",
}

# %%
# Interactive diagnosis function
def get_symptoms():
    symptoms = {}
    questions = ["fever", "cough", "rash", "headache", "nausea", "sore_throat", "fatigue", "weight_loss"]
    print("🩺 Please answer the following questions (y/n):")
    for s in questions:
        ans = input(f"Do you have {s.replace('_', ' ')}? ").strip().lower()
        symptoms[s] = ans == 'y'
    return symptoms

def diagnose(symptoms):
    matches = []
    for (s1, s2), advice in symptom_rules.items():
        if symptoms.get(s1) and symptoms.get(s2):
            matches.append(advice)
    if matches:
        return "\n".join(matches)
    return "⚠️ No clear match – please consult a healthcare professional."

# %%
# Test it!
user_symptoms = get_symptoms()
print("\n📋 Diagnosis:")
print(diagnose(user_symptoms))

