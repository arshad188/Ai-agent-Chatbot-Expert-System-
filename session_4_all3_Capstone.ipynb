# %% [markdown]
# ## 4.1 Expert System (Rule-Based)

# %%
class RestaurantExpert:
    def __init__(self):
        self.rules = [
            {"conditions": {"cuisine": "Italian", "budget": "low"}, "result": "Pizza Hut"},
            {"conditions": {"cuisine": "Italian", "budget": "medium"}, "result": "Olive Garden"},
            {"conditions": {"cuisine": "Chinese", "budget": "low"}, "result": "Panda Express"},
            {"conditions": {"dietary": "vegan"}, "result": "Green Leaf Cafe"},
            {"conditions": {"weather": "rainy"}, "result": "Try indoor dining at The Mall Food Court"},
        ]
    
    def recommend(self, prefs):
        for rule in self.rules:
            match = all(prefs.get(k) == v for k, v in rule["conditions"].items())
            if match:
                return rule["result"]
        return "Try our top pick: Bistro 55"

# Test
expert = RestaurantExpert()
print("Expert:", expert.recommend({"cuisine": "Italian", "budget": "low"}))

# %% [markdown]
# ## 4.2 Chatbot (Conversational)

# %%
class RestaurantChatbot:
    def __init__(self):
        self.responses = {
            "italian": "Great! For Italian, try Olive Garden or Pizza Hut.",
            "chinese": "Panda Express or Dragon Wok are good options.",
            "vegan": "Green Leaf Cafe has excellent plant-based meals.",
            "budget": "We have options from $ to $$$. What's your budget?",
        }
    
    def chat(self, user_input):
        user_input = user_input.lower()
        for key, response in self.responses.items():
            if key in user_input:
                return response
        return "Tell me your cuisine or dietary preference!"

# Test
chatbot = RestaurantChatbot()
print("Chatbot:", chatbot.chat("I want Italian food"))

# %% [markdown]
# ## 4.3 AI Agent (Autonomous)

# %%
import random

class RestaurantAgent:
    def run(self, goal):
        print(f"🤖 Agent planning for: {goal}")
        
        # Simulate tool use
        weather = random.choice(["sunny", "rainy", "cloudy"])
        nearby = random.choice(["Italian place", "Chinese spot", "burger joint"])
        traffic = random.choice(["light", "moderate", "heavy"])
        
        print(f"   📡 Weather: {weather}")
        print(f"   📍 Found: {nearby}")
        print(f"   🚦 Traffic: {traffic}")
        
        # Reasoning
        if weather == "rainy":
            advice = f"Recommend {nearby} - it's indoors."
        else:
            advice = f"Recommend {nearby} - great weather for dining."
        
        if traffic == "heavy":
            advice += " Allow extra travel time."
        
        return advice

# Test
agent = RestaurantAgent()
print("Agent:", agent.run("Find a place for dinner tonight"))

