# %% [markdown]
# ## 3.1 Simple Goal-Based Agent

# %%
class GoalAgent:
    def __init__(self):
        self.knowledge = []
        self.tools = {
            "search": self.search_web,
            "calculate": self.calc,
            "summarize": self.summarize
        }
    
    def search_web(self, query):
        # Simulated search
        return f"Search results for '{query}': [Paper1, Paper2, Paper3]"
    
    def calc(self, expression):
        return eval(expression)
    
    def summarize(self, text):
        return f"Summary: {text[:100]}..."
    
    def plan(self, goal):
        print(f"🎯 Goal: {goal}")
        print("🧠 Planning steps...")
        
        if "research" in goal.lower():
            # Plan: search → summarize → save
            result = self.tools["search"]("AI safety")
            summary = self.tools["summarize"](result)
            self.knowledge.append(summary)
            return f"✅ Research complete: {summary}"
        
        elif "calculate" in goal.lower():
            # Extract numbers from goal
            import re
            nums = re.findall(r'\d+', goal)
            if len(nums) >= 2:
                result = self.tools["calculate"](f"{nums[0]}+{nums[1]}")
                return f"📊 Calculation result: {result}"
        
        return "🤔 Goal not recognized - refining..."
    
    def run(self, goal):
        return self.plan(goal)

# %%
# Test it
agent = GoalAgent()
print(agent.run("Research AI ethics"))
print(agent.run("Calculate 45 + 67"))
print(agent.run("Find papers on climate change"))

# %% [markdown]
# ## 3.2 Tool-Using Agent with Real APIs

# %%
import requests
import json

class ResearchAgent:
    def __init__(self):
        self.tools = {
            "arxiv": self.arxiv_search,
            "wikipedia": self.wikipedia_lookup,
            "save": self.save_to_file
        }
        self.memory = []
    
    def arxiv_search(self, query):
        url = f"http://export.arxiv.org/api/query?search_query=all:{query}&max_results=3"
        response = requests.get(url)
        # Parse XML (simplified)
        papers = []
        for entry in response.text.split("<entry>")[1:]:
            if "<title>" in entry:
                title = entry.split("<title>")[1].split("</title>")[0]
                papers.append(title)
        return f"Found papers: {', '.join(papers)}"
    
    def wikipedia_lookup(self, topic):
        url = f"https://en.wikipedia.org/api/rest_v1/page/summary/{topic.replace(' ', '_')}"
        response = requests.get(url)
        if response.status_code == 200:
            data = response.json()
            return data.get("extract", "No summary")[:300]
        return "Topic not found"
    
    def save_to_file(self, content):
        with open("agent_notes.txt", "a") as f:
            f.write(content + "\n")
        return "✅ Saved to file"
    
    def run(self, goal):
        print(f"🎯 Goal: {goal}")
        # Parse intent
        if "paper" in goal.lower():
            print("📚 Searching academic papers...")
            result = self.tools["arxiv"]("machine learning")
            print("📝 Summarizing...")
            summary = self.tools["wikipedia"]("Machine learning")
            print("💾 Saving...")
            self.tools["save"](f"{result}\n{summary}")
            return f"✅ Research complete! Check agent_notes.txt"
        else:
            return "🤔 Try: 'Find papers on X'"

# %%
# Run the agent
agent = ResearchAgent()
result = agent.run("Find papers on machine learning")
print(result)

